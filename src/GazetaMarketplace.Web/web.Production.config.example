<?xml version="1.0" encoding="utf-8"?>
<!--
  ATENÇÃO: este é só um EXEMPLO, sem valores reais.
  O arquivo real (web.Production.config) NUNCA vai para o git: ele fica no cofre de senhas
  e na máquina de quem publica. Copie este arquivo para web.Production.config e troque cada
  valor entre parênteses. Veja ADR-011 e ARCHITECTURE.md seção 9.
  Os caminhos das três pastas (fotos, chaves, logs) já são os reais da conta no SmarterASP (resposta do provedor, AR-01) e não são segredo.
  As três pastas precisam existir antes da primeira publicação (docs/DEPLOY-RUNBOOK.md, passo "Pastas").
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location>
    <system.webServer>
      <aspNetCore>
        <environmentVariables xdt:Transform="InsertIfMissing">
          <!-- Production, ou Staging para o site de homologação: os dois sobem com as mesmas proteções (HSTS, SendGrid de verdade, configuração validada na partida) -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="(cadeia de conexão do banco)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="PhotoStorage__BasePath" value="h:\root\home\mpaulohs-001\www\gazeta-fotos" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="Logging__FileDirectory" value="h:\root\home\mpaulohs-001\www\gazeta-logs" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="DataProtection__KeysDirectory" value="h:\root\home\mpaulohs-001\www\gazeta-chaves" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="SendGrid__ApiKey" value="(chave do SendGrid)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="SendGrid__FromEmail" value="(e-mail remetente validado no SendGrid)" xdt:Transform="InsertIfMissing" />
          <!-- Endereço público do site, com https (ex.: https://www.seudominio.com.br). Vai nos links enviados por e-mail;
               sem ele o link nasceria do cabeçalho Host da requisição, que um atacante pode forjar (US-007). -->
          <environmentVariable name="Site__BaseUrl" value="(endereço público do site, com https)" xdt:Transform="InsertIfMissing" />
          <!-- Site atrás do Cloudflare (domínio gzto.com.br com o proxy ligado, "nuvem laranja"). Com true o site baixa a lista oficial de faixas de IP do Cloudflare
               na partida (se não conseguir, usa a cópia que vem no pacote Cloudflare.ForwardedHeaders) e lê o IP do visitante do cabeçalho CF-Connecting-IP,
               mas SÓ quando o pedido chega de um endereço do Cloudflare. Não precisa de ForwardedHeaders__KnownProxies__0 para isso. Sem o Cloudflare (ou com false),
               o site ignora cabeçalhos de IP (fail-closed), todos os visitantes dividem um IP e entrar aceita 20 tentativas por 15 minutos em vez de 5. -->
          <environmentVariable name="ForwardedHeaders__Cloudflare" value="true" xdt:Transform="InsertIfMissing" />
          <!-- OPCIONAL, só se o teste do IP (docs/DEPLOY-RUNBOOK.md, 7.1) mostrar um proxy do SmarterASP entre o Cloudflare e o site: acrescente UMA variável por proxy,
               nome ForwardedHeaders__KnownProxies__0 (depois __1, __2...) e, como valor, o IP exato do proxy, sem faixa e sem texto. -->
          <!-- Cifra as chaves do Data Protection com o DPAPI do Windows (identidade do pool). COMEÇA DESLIGADO: o DPAPI por usuário exige que o pool
               do SmarterASP tenha o perfil do usuário carregado, o que só se descobre testando. Depois da primeira publicação funcionando (login, sessão e
               link de redefinição), troque para true, reinicie o site e confira que o login continua funcionando e que o arquivo novo em gazeta-chaves
               tem "dpapi" no texto. Se der erro, volte a false: as chaves cifradas deixam de abrir e a equipe entra de novo, nada mais se perde.
               Em outro sistema que não o Windows, o site recusa subir com true. -->
          <environmentVariable name="DataProtection__ProtectWithDpapi" value="false" xdt:Transform="InsertIfMissing" />
          <!-- NUNCA defina em produção: RateLimiting__*, SendGrid__BaseUrl, ViaCep__BaseUrl, Authentication__SessionMinutes com valor de teste.
               Existem só para a suíte de testes e afrouxam os limites de proteção ou desviam a chave de API (R-39). -->
          <!-- Só na primeira publicação; remova as duas linhas em seguida (ADR-003, RC-19) -->
          <environmentVariable name="Bootstrap__AdminEmail" value="(e-mail do primeiro Administrador)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="Bootstrap__AdminPassword" value="(senha provisória do primeiro Administrador)" xdt:Transform="InsertIfMissing" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
