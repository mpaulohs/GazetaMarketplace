<?xml version="1.0" encoding="utf-8"?>
<!--
  ATENÇÃO: este é só um EXEMPLO, sem valores reais.
  O arquivo real (web.Production.config) NUNCA vai para o git: ele fica no cofre de senhas
  e na máquina de quem publica. Copie este arquivo para web.Production.config e troque cada
  valor entre parênteses. Veja ADR-011 e ARCHITECTURE.md seção 9.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location>
    <system.webServer>
      <aspNetCore>
        <environmentVariables xdt:Transform="InsertIfMissing">
          <!-- Production, ou Staging para o site de homologação: os dois sobem com as mesmas proteções (HSTS, SendGrid de verdade, configuração validada na partida) -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="(cadeia de conexão do banco)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="PhotoStorage__BasePath" value="(pasta de fotos fora da raiz do site)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="Logging__FileDirectory" value="(pasta de logs fora da raiz do site)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="DataProtection__KeysDirectory" value="(pasta das chaves fora da raiz do site)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="SendGrid__ApiKey" value="(chave do SendGrid)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="SendGrid__FromEmail" value="(e-mail remetente validado no SendGrid)" xdt:Transform="InsertIfMissing" />
          <!-- Endereço público do site, com https (ex.: https://www.seudominio.com.br). Vai nos links enviados por e-mail;
               sem ele o link nasceria do cabeçalho Host da requisição, que um atacante pode forjar (US-007). -->
          <environmentVariable name="Site__BaseUrl" value="(endereço público do site, com https)" xdt:Transform="InsertIfMissing" />
          <!-- IP do proxy do SmarterASP (SEC-01, PENDENTE: a resposta vem do ticket aberto no provedor).
               Enquanto não houver o valor real, NÃO crie esta variável: o site ignora X-Forwarded-For (fail-closed), todos os visitantes dividem o IP do proxy,
               e entrar, "esqueci" e "redefinir" aceitam 20 tentativas por 15 minutos para o site inteiro (com o IP certo, 5 por IP). Um Warning na partida lembra disso.
               Quando o provedor responder, acrescente UMA variável por proxy, no mesmo formato das outras linhas deste arquivo:
               nome ForwardedHeaders__KnownProxies__0 (depois __1, __2...) e, como valor, o IP exato do proxy, sem faixa e sem texto. -->
          <!-- Cifra as chaves do Data Protection com o DPAPI do Windows (identidade do pool). Ligue só no servidor Windows;
               em outro sistema o site recusa subir com esta opção ligada. Se a identidade do pool mudar, as chaves antigas não abrem
               e a equipe precisa entrar de novo (os links de redefinição já enviados deixam de valer). -->
          <environmentVariable name="DataProtection__ProtectWithDpapi" value="true" xdt:Transform="InsertIfMissing" />
          <!-- NUNCA defina em produção: RateLimiting__*, SendGrid__BaseUrl, ViaCep__BaseUrl, Authentication__SessionMinutes com valor de teste.
               Existem só para a suíte de testes e afrouxam os limites de proteção ou desviam a chave de API (R-39). -->
          <!-- Só na primeira publicação; remova as duas linhas em seguida (ADR-003, RC-19) -->
          <environmentVariable name="Bootstrap__AdminEmail" value="(e-mail do primeiro Administrador)" xdt:Transform="InsertIfMissing" />
          <environmentVariable name="Bootstrap__AdminPassword" value="(senha provisória do primeiro Administrador)" xdt:Transform="InsertIfMissing" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
