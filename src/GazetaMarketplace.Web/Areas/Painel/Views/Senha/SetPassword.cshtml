@model DefinirSenhaViewModel
@{
    ViewData["Title"] = "Defina sua nova senha";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3">Defina sua nova senha</h1>
                <p>Você entrou com uma senha provisória. Escolha uma senha nova para continuar.</p>

                <form asp-area="Painel" asp-action="SetPassword" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label" asp-for="NovaSenha">Nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["NovaSenha"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="NovaSenha" type="password" autocomplete="new-password" aria-required="true" aria-describedby="ajuda-senha erro-nova" />
                        <span class="invalid-feedback" id="erro-nova" role="alert" asp-validation-for="NovaSenha"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmarSenha">Confirmar nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["ConfirmarSenha"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="ConfirmarSenha" type="password" autocomplete="new-password" aria-required="true" aria-describedby="erro-confirmar" />
                        <span class="invalid-feedback" id="erro-confirmar" role="alert" asp-validation-for="ConfirmarSenha"></span>
                    </div>
                    <p class="form-text" id="ajuda-senha">A senha precisa ter 8 caracteres ou mais, maiúscula, minúscula, número e símbolo.</p>
                    <button class="btn btn-primary w-100 alvo-toque" type="submit">Salvar senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
