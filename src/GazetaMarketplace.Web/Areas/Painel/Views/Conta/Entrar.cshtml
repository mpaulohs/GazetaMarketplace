@model EntrarViewModel
@{
    ViewData["Title"] = "Entrar";
    ViewData["Marca"] = "GazetaMarketplace · Área da equipe";
    bool temErroGeral = ViewData.ModelState.TryGetValue(string.Empty, out var estadoGeral) && estadoGeral.Errors.Count > 0;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3">Entrar</h1>

                @if (Model.SessaoExpirada)
                {
                    <div class="alert alert-warning" role="status">Sua sessão expirou. Entre novamente.</div>
                }

                @if (temErroGeral)
                {
                    <div class="alert alert-danger" role="alert">@estadoGeral.Errors[0].ErrorMessage</div>
                }

                <form asp-area="Painel" asp-action="Entrar" method="post" novalidate>
                    <input type="hidden" asp-for="Retorno" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="Email">E-mail <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Email" type="email" autocomplete="username" autocapitalize="none" spellcheck="false" aria-required="true" aria-describedby="erro-email" />
                        <div class="invalid-feedback" id="erro-email" asp-validation-for="Email"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Senha">Senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["Senha"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Senha" type="password" autocomplete="current-password" aria-required="true" aria-describedby="erro-senha" />
                        <div class="invalid-feedback" id="erro-senha" asp-validation-for="Senha"></div>
                    </div>
                    <button class="btn btn-primary w-100 alvo-toque" type="submit">Entrar</button>
                </form>

                <p class="mt-3 mb-0 text-center"><a href="@RotasDoPainel.EsqueciSenha">Esqueci minha senha</a></p>
            </div>
        </div>
    </div>
</div>
