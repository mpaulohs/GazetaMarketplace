@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3">Redefinir senha de @Model.FullName</h1>
                @await Html.PartialAsync("_GeneralError")

                <form asp-area="Panel" asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ProvisionalPassword">Senha provisória <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["ProvisionalPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="ProvisionalPassword" type="password" autocomplete="new-password" aria-required="true" aria-describedby="password-help error-ProvisionalPassword" />
                        @await Html.PartialAsync("_FieldErrors", "ProvisionalPassword")
                        <p class="form-text" id="password-help">Informe a senha à pessoa fora do sistema. A pessoa precisará trocá-la no próximo acesso. A senha atual deixa de valer e as sessões abertas da conta são encerradas. Requisitos: 8 caracteres ou mais, maiúscula, minúscula, número e símbolo.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary alvo-toque" asp-area="Panel" asp-action="Index">Cancelar</a>
                        <button class="btn btn-primary alvo-toque" type="submit">Redefinir senha</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
