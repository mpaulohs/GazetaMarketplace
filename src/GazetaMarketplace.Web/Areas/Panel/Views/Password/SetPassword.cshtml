@model SetPasswordViewModel
@{
    ViewData["Title"] = "Defina sua nova senha";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3">Defina sua nova senha</h1>
                <p>Você entrou com uma senha provisória. Escolha uma senha nova para continuar.</p>

                <form asp-area="Panel" asp-action="SetPassword" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label" asp-for="NewPassword">Nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="NewPassword" type="password" autocomplete="new-password" aria-required="true" aria-describedby="ajuda-senha erro-nova" />
                        <span class="invalid-feedback" id="erro-nova" role="alert" asp-validation-for="NewPassword"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword">Confirmar nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" aria-describedby="erro-confirmar" />
                        <span class="invalid-feedback" id="erro-confirmar" role="alert" asp-validation-for="ConfirmPassword"></span>
                    </div>
                    <p class="form-text" id="ajuda-senha">A senha precisa ter 8 caracteres ou mais, maiúscula, minúscula, número e símbolo.</p>
                    <button class="btn btn-primary w-100 alvo-toque" type="submit">Salvar senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
