@model RejectViewModel
@{
    ViewData["Title"] = "Rejeitar anúncio";
    bool invalid = ViewData.ModelState[nameof(RejectViewModel.Reason)]?.Errors.Count > 0;
}
@section Scripts {
    <script type="module" asp-module-version="~/js/pages/ad-confirm.js"></script>
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card"><div class="card-body p-3 p-md-4">
        <h1 class="fs-3" tabindex="-1" data-foco-inicial="@(invalid ? null : "")">Rejeitar anúncio</h1>
        <p><strong>@Model.Title</strong></p>
        <form method="post" asp-area="Panel" asp-controller="ReviewQueue" asp-action="Reject" asp-route-id="@Model.Id" data-confirm-submit novalidate>
            <div class="mb-3">
                <label class="form-label" for="motivo">Motivo da rejeição <span aria-hidden="true">*</span></label>
                <textarea class="form-control @(invalid ? "is-invalid" : "")" id="motivo" name="reason" rows="4" maxlength="500" aria-required="true"
                          aria-describedby="ajuda-motivo@(invalid ? " erro-motivo" : "")" aria-invalid="@(invalid ? "true" : null)" autofocus="@(invalid ? "autofocus" : null)">@Model.Reason</textarea>
                @if (invalid)
                {
                    <div class="invalid-feedback d-block" id="erro-motivo" role="alert">@ViewData.ModelState[nameof(RejectViewModel.Reason)].Errors[0].ErrorMessage</div>
                }
                <div class="form-text" id="ajuda-motivo">O motivo fica visível para quem cadastrou o anúncio. Até 500 caracteres.</div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary alvo-toque" asp-area="Panel" asp-controller="ReviewQueue" asp-action="Preview" asp-route-id="@Model.Id">Cancelar</a>
                <button class="btn btn-danger alvo-toque" type="submit" data-confirm-button data-busy-label="Rejeitando…">Rejeitar anúncio</button>
            </div>
        </form>
        </div></div>
    </div>
</div>
