@using GazetaMarketplace.Web.Navigation
@model ReviewPreviewViewModel
@{
    ViewData["Title"] = "Pré-visualização: " + Model.Body.Title;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/review-queue.css" asp-append-version="true" />
}

<p class="mb-2"><a class="alvo-toque d-inline-flex align-items-center" href="@PanelRoutes.ReviewQueue"><i class="fa fa-chevron-left me-1" aria-hidden="true"></i>Fila de revisão</a></p>
<h1 class="fs-3">Pré-visualização do anúncio</h1>

@if (Model.Alert is { Kind: ReviewAlertKind.Conflict } conflict)
{
    @* Outra pessoa decidiu antes (S07): a mensagem, e logo abaixo a situação verdadeira *@
    <div class="alert alert-danger" role="alert" tabindex="-1" data-foco-inicial data-review-conflict>@conflict.Message</div>
}
else if (Model.Alert is { Kind: ReviewAlertKind.PhoneMissing } noPhone)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2" role="alert" data-review-phone>
        <span>@noPhone.Message</span>
        <a class="btn btn-outline-danger btn-sm alvo-toque ms-sm-auto" href="@PanelRoutes.Settings" data-foco-inicial>Configurações</a>
    </div>
}

@if (Model.Pending.Count > 0)
{
    @* A decisão reconfere o que o envio à revisão exige: o anúncio pode ter sido editado depois (por exemplo, sem o preço ou sem a foto) *@
    <div class="alert alert-warning" role="alert" tabindex="-1" data-foco-inicial data-review-pending>
        <p class="fw-semibold mb-2">@(Model.Pending.Count == 1 ? "Falta 1 item para publicar este anúncio:" : $"Faltam {Model.Pending.Count} itens para publicar este anúncio:")</p>
        <ul class="mb-0">
            @foreach (AdPending pending in Model.Pending)
            {
                <li><a asp-area="Panel" asp-controller="Ads" asp-action="Edit" asp-route-id="@Model.Id" asp-fragment="@pending.Target">@pending.Message</a></li>
            }
        </ul>
    </div>
}

@if (Model.InReview)
{
    <div class="alert alert-info" role="status" data-preview-banner><i class="fa fa-info-circle me-1" aria-hidden="true"></i>Pré-visualização — ainda não publicado</div>
    <div class="d-grid d-sm-flex gap-2 mb-3" data-preview-actions>
        <a class="btn btn-primary alvo-toque" asp-area="Panel" asp-controller="ReviewQueue" asp-action="ConfirmPublish" asp-route-id="@Model.Id">Publicar</a>
        <a class="btn btn-outline-danger alvo-toque" asp-area="Panel" asp-controller="ReviewQueue" asp-action="Reject" asp-route-id="@Model.Id">Rejeitar</a>
        <a class="btn btn-outline-primary alvo-toque" asp-area="Panel" asp-controller="Ads" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        @if (Model.Takedown.CanArchive)
        {
            <a class="btn btn-outline-danger alvo-toque" asp-area="Panel" asp-controller="Ads" asp-action="ConfirmArchive" asp-route-id="@Model.Id">Arquivar</a>
        }
    </div>
}
else
{
    <div class="alert alert-warning" role="status" data-preview-not-in-review>Este anúncio não está em revisão. Situação: <strong>@Model.StatusLabel</strong></div>
}

@if (Model.LocationManual)
{
    <p class="mb-3" data-location-manual>
        <span class="badge text-bg-warning me-1">Cidade/UF informadas manualmente (CEP não conferido)</span>
        CEP @Model.Cep · @Model.Body.Location
    </p>
}

<div class="row g-4" data-preview>
    <div class="col-12 col-lg-8">
        @if (Model.IsJob)
        {
            <partial name="_AdJobBlock" model="Model.JobAreas" />
        }
        else
        {
            <partial name="_AdPhotos" model="Model.Photos" />
        }

        @if (Model.CategoryPath is not null)
        {
            <p class="small text-body-secondary mt-3 mb-1" data-category-path>@Model.CategoryPath</p>
        }
        <partial name="_AdBody" model="Model.Body" />
    </div>
    <div class="col-12 col-lg-4">
        @if (Model.Contact is not null)
        {
            <partial name="_Contact" model="Model.Contact" />
        }
        else
        {
            <aside class="card" aria-labelledby="contato-titulo">
                <div class="card-body">
                    <h2 class="fs-5" id="contato-titulo">Fale com a Gazeta</h2>
                    <p class="mb-2" data-phone-missing>O telefone/WhatsApp do site ainda não foi configurado.</p>
                    <a class="btn btn-outline-primary alvo-toque" href="@PanelRoutes.Settings">Configurações</a>
                </div>
            </aside>
        }
    </div>
</div>
