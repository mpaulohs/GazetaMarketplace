@using GazetaMarketplace.Web.Navigation
@model PublishConfirmationViewModel
@{
    ViewData["Title"] = "Publicar anúncio";
}
@section Scripts {
    <script type="module" asp-module-version="~/js/pages/ad-confirm.js"></script>
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        @* Sobre um cartão branco, como a confirmação do envio: os botões de contorno cinza não alcançam o contraste mínimo direto sobre o fundo da página *@
        <div class="card"><div class="card-body p-3 p-md-4">
        <h1 class="fs-3" data-foco-inicial tabindex="-1">Publicar este anúncio?</h1>
        <p><strong>@Model.Title</strong></p>
        <p>Ele passa a aparecer no site para todos os visitantes.</p>
        <form method="post" asp-area="Panel" asp-controller="ReviewQueue" asp-action="Publish" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2" data-confirm-submit>
            <a class="btn btn-outline-secondary alvo-toque" asp-area="Panel" asp-controller="ReviewQueue" asp-action="Preview" asp-route-id="@Model.Id">Cancelar</a>
            <button class="btn btn-primary alvo-toque" type="submit" data-confirm-button data-busy-label="Publicando…">Publicar</button>
        </form>
        </div></div>
    </div>
</div>
