@model string
@* Todas as mensagens de um campo, uma por linha (a lista de requisitos da senha pede mais de uma). Cada uma é anunciada como alerta. *@
@{
    var entry = ViewData.ModelState[Model];
}
@if (entry is { Errors.Count: > 0 })
{
    @* O aviso (role="alert") fica numa div: um role no <ul> tira dele o papel de lista e deixa os <li> órfãos para o leitor de tela *@
    <div id="error-@Model" role="alert">
        <ul class="list-unstyled small text-danger mb-0 mt-1">
            @foreach (var error in entry.Errors)
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
