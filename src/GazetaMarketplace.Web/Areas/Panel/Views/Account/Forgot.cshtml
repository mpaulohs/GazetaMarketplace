@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
    ViewData["Brand"] = "GazetaMarketplace · Área da equipe";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3" tabindex="-1" data-foco-inicial>Esqueci minha senha</h1>

                @if (Model.Sent)
                {
                    <div class="alert alert-info" role="status">@PasswordRecoveryMessages.RequestAccepted</div>
                }
                else
                {
                    <p>Informe o e-mail da sua conta. Enviaremos as instruções.</p>
                    <form asp-area="Panel" asp-action="Forgot" method="post" novalidate>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Email">E-mail <span aria-hidden="true">*</span></label>
                            <input class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" aria-required="true" aria-describedby="erro-email" />
                            <span class="invalid-feedback" id="erro-email" role="alert" asp-validation-for="Email"></span>
                        </div>
                        <button class="btn btn-primary w-100 alvo-toque" type="submit">Enviar</button>
                    </form>
                }

                <p class="mt-3 mb-0 text-center"><a href="@PanelRoutes.SignIn">Voltar para entrar</a></p>
            </div>
        </div>
    </div>
</div>
