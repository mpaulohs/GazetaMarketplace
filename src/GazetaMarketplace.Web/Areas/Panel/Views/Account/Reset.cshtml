@model RecoverPasswordViewModel
@{
    ViewData["Title"] = "Definir nova senha";
    ViewData["Brand"] = "GazetaMarketplace · Área da equipe";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="fs-3 mb-3" tabindex="-1" data-foco-inicial>Definir nova senha</h1>

                <form asp-area="Panel" asp-action="Reset" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Code" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="NewPassword">Nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="NewPassword" type="password" autocomplete="new-password" aria-required="true" aria-describedby="ajuda-senha error-NewPassword" />
                        @await Html.PartialAsync("_FieldErrors", "NewPassword")
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword">Confirmar nova senha <span aria-hidden="true">*</span></label>
                        <input class="form-control @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" aria-describedby="error-ConfirmPassword" />
                        @await Html.PartialAsync("_FieldErrors", "ConfirmPassword")
                    </div>
                    <p class="form-text" id="ajuda-senha">A senha precisa ter 8 caracteres ou mais, maiúscula, minúscula, número e símbolo.</p>
                    <button class="btn btn-primary w-100 alvo-toque" type="submit">Salvar senha</button>
                </form>
            </div>
        </div>
    </div>
</div>
