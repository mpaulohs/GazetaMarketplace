@model SubmitConfirmationViewModel
@{
    ViewData["Title"] = "Enviar para revisão";
}
@section Scripts {
    <script type="module" asp-module-version="~/js/pages/ad-confirm.js"></script>
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        @* Sobre um cartão branco, como o formulário: os botões de contorno cinza não alcançam o contraste mínimo direto sobre o fundo da página *@
        <div class="card"><div class="card-body p-3 p-md-4">
        <h1 class="fs-3" data-foco-inicial tabindex="-1">Enviar para revisão?</h1>
        <p><strong>@Model.Title</strong></p>
        <p>Depois de enviado, o anúncio fica somente para leitura até um Administrador decidir.</p>
        <form method="post" asp-area="Panel" asp-controller="Ads" asp-action="Submit" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2" data-confirm-submit>
            <a class="btn btn-outline-secondary alvo-toque" asp-area="Panel" asp-controller="Ads" asp-action="Edit" asp-route-id="@Model.Id">Cancelar</a>
            <button class="btn btn-primary alvo-toque" type="submit" data-confirm-button>Enviar para revisão</button>
        </form>
        </div></div>
    </div>
</div>
