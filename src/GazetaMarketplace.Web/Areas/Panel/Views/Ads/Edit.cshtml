@model AdFormViewModel
@{
    ViewData["Title"] = Model.Heading;
    bool hasErrors = !ViewData.ModelState.IsValid;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/ads-edit.css" asp-append-version="true" />
}

<div class="ads-edit">
    <p class="mb-2"><a asp-area="Panel" asp-controller="Ads" asp-action="Index"><i class="fa fa-chevron-left me-1" aria-hidden="true"></i>Meus anúncios</a></p>
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h1 class="fs-3 mb-0">@Model.Heading</h1>
        @if (!Model.IsNew)
        {
            <span>Situação: <strong>@Model.StatusLabel</strong></span>
        }
    </div>

    @if (Model.Message is not null)
    {
        <div class="alert alert-success" role="status">@Model.Message</div>
    }
    @if (Model.Warning is not null)
    {
        <div class="alert alert-warning" role="status">@Model.Warning</div>
    }
    @if (Model.RejectionReason is not null)
    {
        <div class="alert alert-danger" role="alert" data-rejection>
            <strong>Este anúncio foi rejeitado.</strong> Motivo: @Model.RejectionReason
        </div>
    }
    @await Html.PartialAsync("_GeneralError")
    @await Html.PartialAsync("_Pendings", Model)
    @if (hasErrors)
    {
        <div class="alert alert-danger" role="alert" tabindex="-1" data-error-summary>Não foi possível salvar. Corrija os campos destacados abaixo.</div>
    }

    <div class="card">
    <div class="card-body p-3 p-md-4">
    <form id="anuncio-form" asp-area="Panel" asp-controller="Ads" asp-action="@(Model.IsNew ? "Create" : "Save")" asp-route-id="@Model.Id" method="post" novalidate data-ad-form data-fields-url="@Url.Action("Fields", "Ads", new { area = "Panel" })">
        <div class="visually-hidden" role="status" data-ad-status></div>
        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
        <p class="text-body-secondary small">* obrigatório para enviar à revisão; o rascunho pode ser salvo só com o título.</p>

        <div class="mb-3">
            <label class="form-label" for="categoria">Categoria <span aria-hidden="true">*</span></label>
            <select class="form-select @(ViewData.ModelState["CategoryId"]?.Errors.Count > 0 ? "is-invalid" : "")" id="categoria" name="CategoryId" data-category-select
                    aria-describedby="ajuda-categoria@(ViewData.ModelState["CategoryId"]?.Errors.Count > 0 ? " error-CategoryId" : "")"
                    aria-invalid="@(ViewData.ModelState["CategoryId"]?.Errors.Count > 0 ? "true" : null)">
                <option value="">Escolha uma categoria</option>
                @foreach (AdCategoryGroup group in Model.Categories)
                {
                    <optgroup label="@group.Label">
                        @foreach (AdCategoryOption option in group.Items)
                        {
                            <option value="@option.Id" selected="@option.Selected">@option.Label</option>
                        }
                    </optgroup>
                }
            </select>
            @await Html.PartialAsync("_FieldErrors", "CategoryId")
            <p class="form-text" id="ajuda-categoria">Os campos abaixo mudam conforme a categoria. Sem JavaScript, use "Atualizar campos" depois de escolher.</p>
        </div>

        <div data-group-region>
            @await Html.PartialAsync("_AdGroupRegion", Model)
        </div>

        @await Html.PartialAsync("_AdLocation", Model)

    </form>

    @* As fotos têm formulários próprios (um formulário não fica dentro de outro); os botões abaixo enviam o formulário do anúncio pelo atributo form *@
    @await Html.PartialAsync("_Photos", Model)

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-primary alvo-toque" type="submit" form="anuncio-form" data-submit-button>@Model.SubmitLabel</button>
        @if (Model.CanSubmit)
        {
            @* Nunca fica desabilitado por pendência: o clique salva e mostra o que falta *@
            <button class="btn btn-outline-primary alvo-toque" type="submit" form="anuncio-form" data-submit-button data-submit-review asp-area="Panel" asp-controller="Ads" asp-action="SubmitForReview" asp-route-id="@Model.Id" formnovalidate>Enviar para revisão</button>
        }
        <button class="btn btn-outline-secondary alvo-toque somente-sem-js" type="submit" form="anuncio-form" id="atualizar-campos" asp-area="Panel" asp-controller="Ads"
                asp-action="@(Model.IsNew ? "RefreshNew" : "Refresh")" asp-route-id="@Model.Id" formnovalidate>Atualizar campos</button>
    </div>
    </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pages/ad-edit.js" asp-append-version="true"></script>
}
