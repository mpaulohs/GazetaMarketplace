@model TakedownConfirmationViewModel
@{
    ViewData["Title"] = "Arquivar anúncio";
}
@section Scripts {
    <script type="module" src="~/js/pages/ad-confirm.js" asp-append-version="true"></script>
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card"><div class="card-body p-3 p-md-4">
        <h1 class="fs-3">Arquivar este anúncio?</h1>
        <p><strong>@Model.Title</strong></p>
        <p>O anúncio sairá do site e não poderá ser reativado.</p>
        <form method="post" asp-area="Panel" asp-controller="Ads" asp-action="Archive" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2" data-confirm-submit>
            <a class="btn btn-outline-secondary alvo-toque" href="@Model.CancelUrl" data-foco-inicial>Cancelar</a>
            <button class="btn btn-danger alvo-toque" type="submit" data-confirm-button data-busy-label="Arquivando…">Arquivar</button>
        </form>
        </div></div>
    </div>
</div>
