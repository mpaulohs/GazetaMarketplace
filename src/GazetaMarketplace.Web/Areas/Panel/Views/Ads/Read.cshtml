@model AdFormViewModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="ads-edit">
    <p class="mb-2"><a asp-area="Panel" asp-controller="Ads" asp-action="Index"><i class="fa fa-chevron-left me-1" aria-hidden="true"></i>Meus anúncios</a></p>
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <h1 class="fs-3 mb-0">@Model.Title</h1>
        <span>Situação: <strong>@Model.StatusLabel</strong></span>
    </div>

    @await Html.PartialAsync("_TakedownActions", Model.Takedown, new ViewDataDictionary(ViewData) { ["AdId"] = Model.Id })
    @if (Model.Message is not null)
    {
        <div class="alert alert-success" role="status">@Model.Message</div>
    }
    @if (Model.Warning is not null)
    {
        <div class="alert alert-warning" role="status">@Model.Warning</div>
    }
    <div class="alert alert-info" role="status" data-read-only>@Model.ReadOnlyMessage</div>

    <dl class="row">
        <dt class="col-sm-3">Categoria</dt>
        <dd class="col-sm-9">@(Model.CategoryName ?? "Não informada")</dd>
        <dt class="col-sm-3">@Model.Group.DescriptionLabel</dt>
        <dd class="col-sm-9 text-break ads-edit__texto">@(Model.Description ?? "Não informada")</dd>
        @if (Model.HasPrice)
        {
            <dt class="col-sm-3">@Model.PriceLabel</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Price) ? "Não informado" : "R$ " + Model.Price)</dd>
        }
        <dt class="col-sm-3">CEP</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Cep) ? "Não informado" : Model.Cep)</dd>
        <dt class="col-sm-3">Cidade / UF</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.City) ? "Não informada" : Model.City + " / " + Model.Uf)</dd>
        @foreach (AdFieldViewModel field in Model.Fields.Where(f => !string.IsNullOrEmpty(f.DisplayValue)))
        {
            <dt class="col-sm-3">@field.Label</dt>
            <dd class="col-sm-9">@field.DisplayValue</dd>
        }
    </dl>

    @await Html.PartialAsync("_Photos", Model)
</div>
