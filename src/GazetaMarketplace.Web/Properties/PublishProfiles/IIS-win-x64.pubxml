<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicação para a hospedagem (SmarterASP, IIS no Windows). Gera a pasta que vai para o servidor.
  Use no Visual Studio (Publicar > IIS-win-x64) ou na linha de comando:
      dotnet publish src/GazetaMarketplace.Web -c Release -p:PublishProfile=IIS-win-x64
  A pasta sai em src/GazetaMarketplace.Web/bin/publish/win-x64/.
  Não leva usuário, senha nem servidor: nada daqui é segredo. Veja docs/INFRA.md.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin/publish/win-x64/</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- Só os componentes nativos do Windows x64 (o ImageMagick sozinho passa de 200 MB com os de todas as plataformas) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- O servidor já tem o ASP.NET Core Hosting Bundle (confirmar a versão 10 com o provedor: docs/INFRA.md) -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
