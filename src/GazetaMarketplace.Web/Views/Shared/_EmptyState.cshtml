@model PageStateViewModel

@* Lista ou página sem nada ainda: mensagem e, se houver, a ação para começar. O título recebe o foco. *@
<section class="estado-pagina text-center py-5">
    <h1 class="fs-3" tabindex="-1" data-foco-inicial>@Model.Title</h1>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="text-body-secondary">@Model.Message</p>
    }
    @if (Url.IsLocalUrl(Model.ActionUrl) && !string.IsNullOrEmpty(Model.ActionText))
    {
        <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</section>
