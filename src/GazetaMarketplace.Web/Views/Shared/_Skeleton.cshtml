@model SkeletonViewModel

@* Carregamento: ocupa o mesmo espaço do conteúdo final (NFR-03). Alturas só por classe: a CSP bloqueia atributo style. *@
<div role="status" aria-busy="true">
    <span class="visually-hidden">Carregando…</span>
    @if (Model.Variant == "linha")
    {
        <div aria-hidden="true">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="esqueleto esqueleto-linha mb-2"></div>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3" aria-hidden="true">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="col">
                    <div class="card esqueleto esqueleto-card">
                        <div class="esqueleto-card__midia"></div>
                        <div class="card-body">
                            <div class="esqueleto-card__texto"></div>
                            <div class="esqueleto-card__texto esqueleto-card__texto--curto"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
