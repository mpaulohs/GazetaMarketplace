@using GazetaMarketplace.Core.Ads
@using GazetaMarketplace.Core.Photos
@model IReadOnlyList<AdPhotoItem>

@* As fotos do anúncio sem JavaScript: a foto em destaque e as miniaturas, cada uma um link para a versão grande. A galeria com setas e ampliação é da página pública (5.2). *@
@if (Model.Count == 0)
{
    <div class="media-reservada ad-fotos__vazio" data-photos-empty><span class="fw-bold">Este anúncio não tem fotos</span></div>
}
else
{
    AdPhotoItem cover = Model[0];
    <section class="ad-fotos" aria-label="Fotos do anúncio" data-ad-photos>
        <figure class="ad-fotos__destaque mb-2">
            <img class="ad-fotos__imagem" src="@cover.LargeUrl" width="@cover.Width" height="@cover.Height" alt="Foto 1 de @Model.Count" data-ad-card-image />
        </figure>
        @if (Model.Count > 1)
        {
            <ol class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                @for (int i = 0; i < Model.Count; i++)
                {
                    (int thumbWidth, int thumbHeight) = AdPresentation.ThumbSize(Model[i].Width, Model[i].Height);
                    <li>
                        <a class="ad-fotos__miniatura" href="@Model[i].LargeUrl" aria-label="Abrir a foto @(i + 1) de @Model.Count em tamanho grande">
                            <img src="@Model[i].ThumbUrl" width="@thumbWidth" height="@thumbHeight" alt="" loading="lazy" />
                        </a>
                    </li>
                }
            </ol>
        }
    </section>
}
