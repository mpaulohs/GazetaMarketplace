@model EstadoPaginaViewModel

@* Falha de página ou de lista: mensagem, "Tentar novamente" e o código de referência do log. O título recebe o foco. *@
<section class="estado-pagina text-center py-5">
    <h1 class="fs-3" tabindex="-1" data-foco-inicial>@Model.Titulo</h1>
    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <p>@Model.Mensagem</p>
    }
    @if (Url.IsLocalUrl(Model.AcaoUrl))
    {
        <a class="btn btn-primary" href="@Model.AcaoUrl">@(Model.AcaoTexto ?? "Tentar novamente")</a>
    }
    @if (!string.IsNullOrEmpty(Model.CodigoReferencia))
    {
        <p class="small text-body-secondary mt-3">Código de referência: <code>@Model.CodigoReferencia</code></p>
    }
</section>
