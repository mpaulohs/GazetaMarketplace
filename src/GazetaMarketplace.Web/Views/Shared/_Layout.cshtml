@using GazetaMarketplace.Web.Navigation
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? title + " · " : "")GazetaMarketplace</title>
    <link rel="preload" href="~/lib/poppins/files/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/lib/poppins/files/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/poppins.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/bootstrap-tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/estados.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/card.css" asp-append-version="true" />
    <noscript><link rel="stylesheet" href="~/css/sem-js.css" asp-append-version="true" /></noscript>
    <partial name="_Seo" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="corpo-pagina">
    <a class="visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>
    <header class="cabecalho">
        <div class="container py-2 d-flex flex-wrap align-items-center gap-2 gap-md-3">
            <a class="cabecalho__marca alvo-toque d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">GazetaMarketplace</a>
            <a class="cabecalho__favoritos alvo-toque" href="@PublicRoutes.Favorites"><i class="fa fa-heart-o me-2" aria-hidden="true"></i><span class="cabecalho__rotulo">Favoritos&nbsp;</span>(<span data-favoritos-contagem>0</span>)</a>
            <form class="cabecalho__busca" role="search" method="get" action="@PublicRoutes.Search">
                <label class="visually-hidden" for="busca-q">Buscar anúncios</label>
                @if (ViewData["SearchCarry"] is IEnumerable<KeyValuePair<string, string>> carry)
                {
                    <partial name="_SearchCarry" model="carry" />
                }
                <div class="input-group">
                    <input class="form-control@(ViewData["SearchError"] is null ? "" : " is-invalid")" id="busca-q" name="q" type="search" placeholder="Buscar anúncios…" autocomplete="off" value="@(ViewData["SearchText"] as string)" aria-describedby="@(ViewData["SearchError"] is null ? null : "busca-q-erro")" aria-invalid="@(ViewData["SearchError"] is null ? null : "true")" />
                    <button class="btn btn-primary alvo-toque" type="submit"><i class="fa fa-search me-1" aria-hidden="true"></i>Buscar</button>
                </div>
                @if (ViewData["SearchError"] is string searchError)
                {
                    <div class="invalid-feedback d-block" id="busca-q-erro" role="alert">@searchError</div>
                }
            </form>
        </div>
    </header>
    <div class="container mt-3">
        <div id="avisos-globais" class="alert alert-danger" role="alert" hidden></div>
    </div>
    <div class="container corpo-pagina__conteudo">
        <main id="conteudo" tabindex="-1" class="pt-3 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="rodape mt-4 py-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year GazetaMarketplace</span>
            <a href="@PanelRoutes.SignIn">Área da equipe</a>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" asp-module-version="~/js/pages/layout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
