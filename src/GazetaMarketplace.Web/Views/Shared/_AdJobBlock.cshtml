@model IReadOnlyList<string>

@* Vaga de emprego não tem foto (A4): no lugar da galeria vai o bloco neutro com as áreas marcadas. Igual na pré-visualização e na página pública. *@
<section class="media-reservada ad-vaga mb-3 px-3" aria-labelledby="vaga-titulo" data-job-block>
    <h2 class="fs-5 fw-bold" id="vaga-titulo">Vaga de emprego</h2>
    @if (Model.Count > 0)
    {
        <ul class="list-unstyled mb-0">
            @foreach (string area in Model)
            {
                <li>@area</li>
            }
        </ul>
    }
</section>
