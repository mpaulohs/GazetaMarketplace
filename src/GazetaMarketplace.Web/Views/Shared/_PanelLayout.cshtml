@using GazetaMarketplace.Core.Team
@using GazetaMarketplace.Web.Navigation
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    bool signedIn = User.Identity?.IsAuthenticated == true;
    bool changingPassword = User.HasClaim(GazetaMarketplace.Web.Security.TeamClaims.MustChangePassword, "1");
    string role = User.IsInRole(RoleNames.Administrator) ? RoleNames.Administrator : User.IsInRole(RoleNames.Writer) ? RoleNames.Writer : null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string title ? title + " · " : "")Painel · GazetaMarketplace</title>
    <link rel="preload" href="~/lib/poppins/files/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/lib/poppins/files/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/poppins.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/bootstrap-tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/estados.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/card.css" asp-append-version="true" />
    <noscript><link rel="stylesheet" href="~/css/sem-js.css" asp-append-version="true" /></noscript>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="corpo-pagina">
    <a class="visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>
    <header class="cabecalho">
        <nav class="navbar navbar-expand-md" aria-label="Menu do painel">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">@(ViewData["Brand"] ?? "Gazeta · Painel")</a>
                @if (signedIn)
                {
                    <button class="navbar-toggler alvo-toque" type="button" data-bs-toggle="collapse" data-bs-target="#menu-painel" aria-controls="menu-painel" aria-expanded="false">
                        Menu
                    </button>
                    <div class="collapse navbar-collapse" id="menu-painel">
                        @if (!changingPassword)
                        {
                            @await Component.InvokeAsync("PanelMenu")
                        }
                        <div class="ms-md-auto d-flex flex-column flex-md-row align-items-md-center gap-2 mt-2 mt-md-0">
                            <span>@(User.FindFirst(GazetaMarketplace.Web.Security.TeamClaims.FullName)?.Value ?? User.Identity.Name)@(role is null ? "" : " (" + role + ")")</span>
                            <form method="post" action="@PanelRoutes.SignOut">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light alvo-toque" type="submit"><i class="fa fa-sign-out me-1" aria-hidden="true"></i>Sair</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container mt-3">
        <div id="avisos-globais" class="alert alert-danger" role="alert" hidden></div>
    </div>
    <div class="container corpo-pagina__conteudo">
        <main id="conteudo" tabindex="-1" class="pt-3 pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" asp-module-version="~/js/pages/layout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
