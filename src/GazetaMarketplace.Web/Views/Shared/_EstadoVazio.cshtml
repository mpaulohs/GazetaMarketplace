@model EstadoPaginaViewModel

@* Lista ou página sem nada ainda: mensagem e, se houver, a ação para começar. O título recebe o foco. *@
<section class="estado-pagina text-center py-5">
    <h1 class="fs-3" tabindex="-1" data-foco-inicial>@Model.Titulo</h1>
    @if (!string.IsNullOrEmpty(Model.Mensagem))
    {
        <p class="text-body-secondary">@Model.Mensagem</p>
    }
    @if (Url.IsLocalUrl(Model.AcaoUrl) && !string.IsNullOrEmpty(Model.AcaoTexto))
    {
        <a class="btn btn-primary" href="@Model.AcaoUrl">@Model.AcaoTexto</a>
    }
</section>
