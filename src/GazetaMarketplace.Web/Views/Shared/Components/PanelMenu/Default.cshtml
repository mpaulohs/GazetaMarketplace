@using GazetaMarketplace.Web.Navigation
@model IReadOnlyList<MenuItem>

@if (Model.Count > 0)
{
    <ul class="navbar-nav">
        @foreach (MenuItem item in Model)
        {
            <li class="nav-item">
                <a class="nav-link alvo-toque d-flex align-items-center @(item.Active ? "active fw-semibold" : "")" href="@item.Path" aria-current="@(item.Active ? "page" : null)">@item.Text</a>
            </li>
        }
    </ul>
}
