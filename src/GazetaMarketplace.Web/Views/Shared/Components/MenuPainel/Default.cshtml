@using GazetaMarketplace.Web.Navegacao
@model IReadOnlyList<ItemDeMenu>

@if (Model.Count > 0)
{
    <ul class="navbar-nav">
        @foreach (ItemDeMenu item in Model)
        {
            <li class="nav-item">
                <a class="nav-link alvo-toque d-flex align-items-center @(item.Ativo ? "active fw-semibold" : "")" href="@item.Caminho" aria-current="@(item.Ativo ? "page" : null)">@item.Texto</a>
            </li>
        }
    </ul>
}
