@using GazetaMarketplace.Core.Categories
@using GazetaMarketplace.Web.Navigation
@model AdPageViewModel
@{
    AdDetail detail = Model.Detail;
    ViewData["Title"] = detail.Body.Title;
}
@{
    // Indexável: descrição e endereço canônico da página, e o mínimo do Open Graph (título, descrição e a capa) para a prévia no WhatsApp
    ViewData[SeoModel.ViewDataKey] = new SeoModel
    {
        Description = Model.MetaDescription,
        CanonicalUrl = Model.CanonicalUrl,
        OgTitle = detail.Body.Title,
        OgDescription = Model.MetaDescription,
        OgImage = Model.OgImageUrl
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/showcase.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/ad-detail.css" asp-append-version="true" />
}
@section Scripts {
    @if (!detail.IsJob && detail.Photos.Count > 0)
    {
        <script type="module" asp-module-version="~/js/pages/ad-detail.js"></script>
    }
}

<nav aria-label="Caminho de navegação" class="categoria-caminho" data-breadcrumb>
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a href="@PublicRoutes.Home">Início</a></li>
        @foreach (CategoryNode step in detail.Path)
        {
            <li class="breadcrumb-item"><a href="@PublicRoutes.Category(step.Slug)">@step.Name</a></li>
        }
        <li class="breadcrumb-item active text-break" aria-current="page">@detail.Body.Title</li>
    </ol>
</nav>

<div class="row g-4" data-ad-detail>
    <div class="col-12 col-lg-8">
        @if (detail.IsJob)
        {
            <partial name="_AdJobBlock" model="detail.JobAreas" />
        }
        else if (detail.Photos.Count > 0)
        {
            <partial name="_AdGallery" model="new AdGalleryViewModel(detail.Photos, detail.Body.Title)" />
        }
        else
        {
            <div class="media-reservada ad-fotos__vazio" data-photos-empty><span class="fw-bold">Este anúncio não tem fotos</span></div>
        }

        <div class="mt-3">
            <partial name="_AdBody" model="detail.Body" />
        </div>
    </div>
    @* Contato do intermediário (US-004); o botão "Favoritar" (tarefa 5.5) entra nesta coluna. No celular a coluna vem depois da descrição *@
    <div class="col-12 col-lg-4" data-contact-slot>
        @if (Model.Contact is not null)
        {
            <partial name="_Contact" model="Model.Contact" />
        }
        @* Só com JavaScript (os favoritos moram no navegador): o favorites-ui.js tira o "hidden" e troca o texto entre "Favoritar" e "Favoritado" *@
        <button type="button" class="btn btn-outline-secondary alvo-toque w-100 mt-3" hidden data-favorite-toggle data-ad-id="@Model.AdId" aria-pressed="false"><i class="fa fa-heart-o me-2" aria-hidden="true"></i><span data-favorite-label>Favoritar</span></button>
    </div>
</div>
