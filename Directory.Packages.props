    <!-- Example: <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" /> -->
  </ItemGroup>

  <ItemGroup Label="Analysis Packages">
    <!-- Example: <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.4.0" /> -->
  </ItemGroup>
</Project>