    <None Include="..\GazetaMarketplace.Web.Tests\Favorites\favorite-ids-parity.json" Link="Favorites\favorite-ids-parity.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\GazetaMarketplace.Web.Tests\Screens\screens.json" Link="Screens\screens.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GazetaMarketplace.Web.Tests\Performance\Budgets.cs" Link="Performance\Budgets.cs" />
